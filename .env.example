# Supabase (same project as the current site)
NEXT_PUBLIC_SUPABASE_URL=https://uxvukpvbznddlzpjceeo.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Canonical site origin (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://www.ep-journals.org

# Shared secret for the on-demand revalidation route (/api/revalidate).
# Must match the REVALIDATE_SECRET set on the ingest-oai Supabase Edge Function.
REVALIDATE_SECRET=generate-a-long-random-string

# Google Analytics 4 Measurement ID (optional). When set, GA4 loads site-wide.
# Format: G-XXXXXXXXXX. Set this in Vercel env to activate analytics.
NEXT_PUBLIC_GA_ID=

# Google Ads tag ID (optional). Format: AW-XXXXXXXXXX. Enables Google Ads
# remarketing + enhanced conversions. Loaded via the same gtag.js as GA4.
NEXT_PUBLIC_GOOGLE_ADS_ID=

# ── Editorial Board Recruitment System ──────────────────────────────────────
# Supabase SERVICE ROLE key (SERVER ONLY — never expose to the browser). Used by
# the editorial-board API routes to insert applications, upload CVs to the
# private bucket, and read them for the admin dashboard.
# Supabase Dashboard → Project Settings → API → service_role secret.
SUPABASE_SERVICE_ROLE_KEY=

# Resend transactional email. A single notification is sent to the editorial
# office per application (NO email is ever sent to the applicant).
RESEND_API_KEY=
# Verified Resend sender — must be on your verified sending domain.
EDITORIAL_FROM_EMAIL=EP Journals Group <info@ep-journals.org>
# Recipient of new-application notifications.
EDITORIAL_NOTIFY_EMAIL=info@ep-journals.org

# Shared secret gating the editorial-board admin dashboard + API. Generate a
# long random string; it is entered at /admin/editorial-board.
ADMIN_DASHBOARD_TOKEN=
